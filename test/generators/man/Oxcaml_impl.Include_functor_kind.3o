
.TH Include_functor_kind 3 "" "Odoc" "OCaml Library"
.SH Name
Oxcaml_impl\.Include_functor_kind
.SH Synopsis
.sp 
.in 2
\fBModule Oxcaml_impl\.Include_functor_kind\fR
