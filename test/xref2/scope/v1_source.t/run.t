Source links through a virtual library (doc/scope_model.mld, section 3.5,
and the row "Find the implementation of a unit" in section 7). odoc finds
the implementation behind a name through shapes, which name units. It
should take the implementation of each name among the libraries of the
unit being linked, which hold at most one, as dune forbids two
implementations of one virtual library in a closure. If there is none,
there should be no source link.

The setup is what dune builds for a virtual library [vlib] with one virtual
module [Clock], and two implementations [impl_a] and [impl_b]. [vlib] has
dune's alias module [Vlib], with [module Clock = Vlib__Clock]; the file
[vlib/vlib.ml] stands for dune's [vlib.ml-gen]. Each implementation has its
own alias module, such as [Vlib__impl_a__], and a [clock.ml] compiled
against [vlib]'s [vlib__Clock.cmi], which is copied into the
implementation's directory: [-intf-suffix .ml] makes the compiler use that
[.cmi] and not write a new one. dune links [vlib]'s other [.cmi] files into
each implementation's directory; here [-I vlib] does the same job. [impl_a]
also has a private module [Extra], whose [extra.ml] calls [Clock.now].
[user] is built against [vlib] only, and [tool] against [impl_a], and so
[vlib]. Both have a [.ml] that calls [Vlib.Clock.now]. Every compile uses
dune's [-no-alias-deps].

The source files:

  $ cat impl_b/clock.ml
  type t = float
  
  let now () = 2.0
  $ cat impl_a/clock.ml
  type t = int
  
  let now () = 1
  $ cat impl_a/vlib__impl_a__.ml
  (* generated by dune *)
  
  (** @canonical Vlib.Clock *)
  module Clock = Vlib__Clock
  
  (** @canonical Vlib.Extra *)
  module Extra = Vlib__impl_a__Extra
  $ cat impl_b/vlib__impl_b__.ml
  (* generated by dune *)
  
  (** @canonical Vlib.Clock *)
  module Clock = Vlib__Clock

  $ cat vlib/vlib.ml
  (* generated by dune *)
  
  (** @canonical Vlib.Clock *)
  module Clock = Vlib__Clock
  $ cat vlib/clock.mli
  type t
  
  val now : unit -> t
  $ cat impl_a/extra.mli
  val c : unit -> string
  $ cat impl_a/extra.ml
  let c () = ignore (Clock.now ()); "a"
  $ cat user/user.ml
  let stamp () = Vlib.Clock.now ()
  $ cat tool/tool.ml
  let stamp () = Vlib.Clock.now ()
  $ ocamlc -bin-annot -no-alias-deps -opaque -nopervasives -nostdlib -w -49 -I vlib -o vlib/vlib.cmo -c -impl vlib/vlib.ml
  $ ocamlc -bin-annot -no-alias-deps -opaque -I vlib -open Vlib -o vlib/vlib__Clock.cmi -c -intf vlib/clock.mli
  $ for i in a b; do
  >   ocamlc -bin-annot -no-alias-deps -opaque -nopervasives -nostdlib -w -49 -I impl_$i -o impl_$i/vlib__impl_${i}__.cmo -c -impl impl_$i/vlib__impl_${i}__.ml
  >   cp vlib/vlib__Clock.cmi impl_$i/
  >   ocamlc -bin-annot -no-alias-deps -opaque -I impl_$i -I vlib -intf-suffix .ml -open Vlib__impl_${i}__ -o impl_$i/vlib__Clock.cmo -c -impl impl_$i/clock.ml
  > done
  $ ocamlc -bin-annot -no-alias-deps -opaque -I impl_a -I vlib -open Vlib__impl_a__ -o impl_a/vlib__impl_a__Extra.cmi -c -intf impl_a/extra.mli
  $ ocamlc -bin-annot -no-alias-deps -opaque -I impl_a -I vlib -open Vlib__impl_a__ -o impl_a/vlib__impl_a__Extra.cmo -c -impl impl_a/extra.ml
  $ ocamlc -bin-annot -no-alias-deps -I user -I vlib -c user/user.ml
  $ ocamlc -bin-annot -no-alias-deps -I tool -I impl_a -I vlib -c tool/tool.ml

The driver documents [vlib]'s [vlib__Clock.cmti] for [vlib], and again for
each implementation as an implementation copy (as odoc_driver does, in
[Packages.remap_virtual] and [Odoc_unit.fix_virtual]). It runs [odoc
compile-impl] on each [.cmt] whose source it finds, with a [--source-id].
That includes the alias modules, whose source is dune's [.ml-gen] file.
Every [odoc compile] and [odoc compile-impl] gets [-L] for the unit's own
library and its dependencies (D8).

  $ odoc compile --output-dir h --parent-id pkg/vlib -L vlib:h/pkg/vlib vlib/vlib__Clock.cmti
  $ odoc compile --output-dir h --parent-id pkg/vlib -L vlib:h/pkg/vlib vlib/vlib.cmt
  $ odoc compile-impl --output-dir h --parent-id pkg/vlib --source-id pkg/src/vlib/vlib.ml -L vlib:h/pkg/vlib vlib/vlib.cmt
  $ for i in a b; do
  >   odoc compile --output-dir h --parent-id pkg/impl_$i -L impl_$i:h/pkg/impl_$i -L vlib:h/pkg/vlib vlib/vlib__Clock.cmti
  >   odoc compile-impl --output-dir h --parent-id pkg/impl_$i --source-id pkg/src/impl_$i/clock.ml -L impl_$i:h/pkg/impl_$i -L vlib:h/pkg/vlib impl_$i/vlib__Clock.cmt
  >   odoc compile-impl --output-dir h --parent-id pkg/impl_$i --source-id pkg/src/impl_$i/vlib__impl_${i}__.ml -L impl_$i:h/pkg/impl_$i -L vlib:h/pkg/vlib impl_$i/vlib__impl_${i}__.cmt
  > done
  $ odoc compile-impl --output-dir h --parent-id pkg/impl_a --source-id pkg/src/impl_a/extra.ml -L impl_a:h/pkg/impl_a -L vlib:h/pkg/vlib impl_a/vlib__impl_a__Extra.cmt
  $ odoc compile-impl --output-dir h --parent-id pkg/user --source-id pkg/src/user/user.ml -L user:h/pkg/user -L vlib:h/pkg/vlib user/user.cmt
  $ odoc compile-impl --output-dir h --parent-id pkg/tool --source-id pkg/src/tool/tool.ml -L tool:h/pkg/tool -L impl_a:h/pkg/impl_a -L vlib:h/pkg/vlib tool/tool.cmt

Everything is linked with every library.

  $ L="-L vlib:h/pkg/vlib -L impl_a:h/pkg/impl_a -L impl_b:h/pkg/impl_b -L user:h/pkg/user -L tool:h/pkg/tool"
Case 1 (V1). Source links through a virtual module.

[vlib]'s page for [Vlib.Clock] is the expansion of [vlib]'s own
[Vlib__Clock]. [vlib] has no implementation of it, so the page should have
no link into any [clock.ml]. Here [grep] finds no such link, and exits with
1. [vlib]'s libraries hold one unit [Vlib__Clock], so a warning from linking
[vlib] would be wrong.

  $ odoc link $L h/pkg/vlib/vlib.odoc
  $ odoc html-generate -o html h/pkg/vlib/vlib.odocl
  $ grep -o 'href="[^"]*"' html/pkg/vlib/Vlib/Clock/index.html | grep src
  [1]

In [user.ml], [Vlib.Clock.now] reaches the unit [Vlib__Clock], with the
origin [user]. [user]'s libraries hold only [vlib]'s unit, which has no
implementation, so there should be no link into any [clock.ml].

In [tool.ml], the same name has the origin [tool]: source links follow roots
the compiler made, with [Vlib]'s alias already followed, and their origin is
the unit whose compiled file holds them (section 3.1). Its candidates are
[vlib]'s unit and [impl_a]'s copy. Only [impl_a]'s library holds an
implementation of [Clock], so V1 should give [impl_a]'s copy, and the link
should go to [impl_a]'s [clock.ml]. It should never go to [impl_b]'s, which
is not among [tool]'s libraries.

In [impl_a]'s [extra.ml], [Clock.now] should link to [impl_a]'s own
[clock.ml], by the same argument.

odoc does not tell a copy from the virtual library's unit yet (section 11),
so the interface may be [vlib]'s unit. The source link does not need the
interface: the libraries of [tool], and of [extra.ml]'s unit, hold one
implementation of [Clock], [impl_a]'s, so both links should still go to
[impl_a]'s [clock.ml] (section 7). A link into [impl_b]'s [clock.ml] would
be wrong, and so would no link.

  $ for u in user/impl-user tool/impl-tool impl_a/impl-vlib__impl_a__Extra; do odoc link $L h/pkg/$u.odoc; done
  $ odoc html-generate-source --impl h/pkg/user/impl-user.odocl -o html user/user.ml
  $ grep -o 'href="[^"]*"' html/pkg/src/user/user.ml.html | grep 'clock.ml'
  [1]
  $ odoc html-generate-source --impl h/pkg/tool/impl-tool.odocl -o html tool/tool.ml
  $ grep -o 'href="[^"]*"' html/pkg/src/tool/tool.ml.html | grep 'clock.ml'
  [1]
  $ odoc html-generate-source --impl h/pkg/impl_a/impl-vlib__impl_a__Extra.odocl -o html impl_a/extra.ml
  $ grep -o 'href="[^"]*"' html/pkg/src/impl_a/extra.ml.html | grep 'clock.ml'
  href="clock.ml.html#val-now"

The answer should not depend on the order of the [-L] flags at link:

  $ L2="-L impl_b:h/pkg/impl_b -L tool:h/pkg/tool -L vlib:h/pkg/vlib -L impl_a:h/pkg/impl_a"
  $ odoc link $L2 h/pkg/tool/impl-tool.odoc
  $ odoc html-generate-source --impl h/pkg/tool/impl-tool.odocl -o html tool/tool.ml
  $ grep -o 'href="[^"]*"' html/pkg/src/tool/tool.ml.html | grep 'clock.ml'
  [1]
